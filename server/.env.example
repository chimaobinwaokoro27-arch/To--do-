PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=

# Signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where the SQLite file is stored. Defaults to server/data/todo.db.
# On a host with a persistent disk, point this at the mounted disk,
# for example: DB_PATH=/var/data/todo.db
# DB_PATH=

# Cookie SameSite policy. Leave unset in production to use "none", which is
# required when the frontend and API are on different domains. Set to "lax"
# when both apps share one domain.
# COOKIE_SAMESITE=

# Timezone used for deadline and reminder calculations. Node reads TZ by
# itself, so set this to your local timezone on the host, for example:
# TZ=Africa/Lagos
# TZ=
