{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "taskflow-api"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "*/1 * * * *"
    }
  ],
  "services": {
    "taskflow-api": {
      "root": "server",
      "entrypoint": "src/app.js",
      "buildCommand": "npm ci"
    }
  }
}
